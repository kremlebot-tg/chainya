# Все интеграции остаются выключенными, пока режим явно не изменён.
# Только точное значение 0 снимает общую тестовую блокировку.
CHAINYA_TEST_MODE=1
# Для терминала с суффиксом DEMO допустим только TBANK_CHECKOUT_MODE=demo.
TBANK_CHECKOUT_MODE=off
CDEK_INTEGRATION_MODE=off
SABY_ORDER_SYNC_MODE=off
# Как отражать оплаченную покупку в Saby:
# delivery — существующий API заказов (нужен продукт Saby Delivery);
# fiscal_sale — API кассовой продажи: чек Saby + складское списание;
# external_ofd — импорт уже созданных чеков, настраивается внутри Saby.
# fiscal_sale открывается только при TBANK_RECEIPT_ENABLED=0 и полностью
# заполненных параметрах ККТ; иначе checkout и запись закрываются fail-closed.
SABY_PURCHASE_ROUTE=delivery
# Обязательный companyID именно для /retail/sale/create. Не копировать сюда
# SABY_POINT_ID по догадке: значение подтверждается отдельно до первой записи.
SABY_OFD_COMPANY_ID=
SABY_OFD_KKT_REG_NUMBER=
# 2 — УСН «Доходы». Код пока реализует только 4 («полный расчёт»), но включать
# его можно лишь после подтверждения для фактической схемы выдачи/CDEK.
SABY_OFD_TAX_SYSTEM=2
SABY_OFD_PAY_METHOD=
# Не разрешать продажу при отрицательном остатке без отдельного решения.
SABY_OFD_ALLOW_NEGATIVE_STOCK=0
# Обязательная защита live checkout: свежая read-only проверка остатка Saby и
# локальный резерв на 15 минут перед одностадийной оплатой.
# Без auto checkout маршрута fiscal_sale закрыт.
SABY_STOCK_GUARD_MODE=off
# Set to an aware ISO-8601 timestamp when enabling auto. Paid orders before
# this instant remain pending and are never backfilled automatically.
SABY_ORDER_SYNC_STARTED_AT=
# Независимая безопасная сверка каталога: только GET-запросы Saby.
# Она не меняет каталог и не разрешает передачу заказов.
SABY_CATALOG_SHADOW_MODE=off
SABY_CATALOG_SHADOW_INTERVAL_SECONDS=300

# Интернет-эквайринг Т-Банка (не путать с физическим терминалом в чайной).
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=

# Онлайн-чек. Не включать, пока бухгалтер/кассовый провайдер не подтвердили
# СНО, НДС и версию ФФД. Боевой checkout без настроенного чека заблокирован.
TBANK_RECEIPT_ENABLED=0
TBANK_RECEIPT_TAXATION=
TBANK_RECEIPT_ITEM_TAX=
TBANK_RECEIPT_DELIVERY_TAX=
TBANK_RECEIPT_FFD_VERSION=

# API действующего кабинета CDEK. Арман подтвердил, что СДЭК у Чайни уже есть.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_ROOT=https://api.cdek.ru/v2
CDEK_FROM_CITY_CODE=44
CDEK_SENDER_CITY=Москва
CDEK_SENDER_ADDRESS=ул. Острякова, 3
CDEK_SENDER_NAME=Чайня
CDEK_SENDER_PHONE=+79055908801
# Код ПВЗ, куда Чайня физически сдаёт посылки. Без него расчёт работает,
# но создание реального отправления остаётся заблокированным.
CDEK_SHIPMENT_POINT=
CDEK_PACKAGE_LENGTH_CM=20
CDEK_PACKAGE_WIDTH_CM=15
CDEK_PACKAGE_HEIGHT_CM=10
CDEK_PACKAGING_WEIGHT_G=150
CDEK_PIECE_WEIGHT_G=100
