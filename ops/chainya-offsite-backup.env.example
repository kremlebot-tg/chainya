# Public recovery certificate only. The private key must never be present on
# either production server or committed to Git.
CHAINYA_OFFSITE_RECIPIENT_CERT=/etc/chainya-backup-recipient.pem

# Dedicated restricted SSH account and directory on independent storage.
CHAINYA_OFFSITE_DESTINATION=backup-user@backup-host.example:/srv/chainya/
CHAINYA_OFFSITE_SSH_IDENTITY=/etc/chainya-offsite-id_ed25519
CHAINYA_OFFSITE_KNOWN_HOSTS=/etc/chainya-offsite-known_hosts
