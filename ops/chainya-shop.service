[Unit]
Description=Chainya checkout backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chainya-shop
Group=chainya-shop
UMask=0077
WorkingDirectory=/opt/chainya-shop
Environment=CHAINYA_DATA_DIR=/var/lib/chainya-shop
Environment=CHAINYA_CATALOG_PATH=/var/lib/chainya-shop/catalog.json
Environment=CHAINYA_CATALOG_SEED_PATH=/opt/chainya-shop/backend/catalog.seed.json
Environment=CHAINYA_CATALOG_MEDIA_DIR=/var/lib/chainya-shop/catalog-media
EnvironmentFile=-/etc/chainya-shop.env
EnvironmentFile=-/etc/chainya-shop-admin.env
EnvironmentFile=-/etc/chainya-shop-saby.env
EnvironmentFile=-/etc/chainya-shop-integrations.env
# Публичные запросы уже пишет Nginx. Uvicorn access log отключён, чтобы query
# token страниц заказа и оплаты не дублировался в journald.
ExecStart=/opt/chainya-shop/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8077 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chainya-shop

[Install]
WantedBy=multi-user.target
