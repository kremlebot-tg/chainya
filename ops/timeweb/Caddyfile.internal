{
	admin off
	auto_https off
}

(chainya_origin) {
	reverse_proxy https://79.137.194.101 {
		transport http {
			tls_server_name chainya.ru
		}
		header_up Host chainya.ru
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up X-Real-IP {http.request.header.X-Forwarded-For}
		# Origin keeps the same headers for direct rollback traffic. At the edge
		# strip those copies and emit one canonical value below, otherwise private
		# pages receive the same header two or three times.
		header_down -Strict-Transport-Security
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
		header_down -Permissions-Policy
		header_down -Content-Security-Policy
		header_down -X-Robots-Tag
	}
}

(chainya_public_headers) {
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://yandex.ru; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
	}
}

http://127.0.0.1:8078 {
	encode zstd gzip
	root * /var/www/chainya

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Docker проверяет только сам внутренний edge. Этот endpoint не уходит на
	# production-origin и остаётся доступен во время Chainya-only maintenance.
	handle /__chainya_edge_health {
		respond 200
	}

	# Marker создаётся на host в /var/www и виден через read-only mount. Внешний
	# Caddy направляет на этот listener только chainya.ru, поэтому остальные
	# сайты и VPN-транспорты на сервере не затрагиваются.
	@maintenance {
		not path /__chainya_edge_health
		file {
			root /var/www
			try_files /chainya-maintenance.enabled
		}
	}
	handle @maintenance {
		header {
			Cache-Control "no-store"
			Retry-After "120"
			X-Robots-Tag "noindex, nofollow"
		}
		respond "Чайня обновляется. Пожалуйста, попробуйте снова через пару минут." 503
	}

	@sensitive path_regexp sensitive (?i)(^|/)(?:\.env(?:\..*)?|\.git(?:/|$)|\.DS_Store$|\._[^/]*$|__pycache__(?:/|$)|README(?:\.[^/]*)?$)
	respond @sensitive 404

	@sensitiveExtension path_regexp sensitiveExtension (?i)\.(?:py|pyc|zip|tar|gz|sql|sqlite|sqlite3|db|bak|backup|old)$
	respond @sensitiveExtension 404

	@testPay path_regexp testPay ^/api/orders/[^/]+/test-pay/?$
	respond @testPay 404
	respond /test-payment/* 404

	@catalogManage path /manage/catalog /manage/catalog/
	handle @catalogManage {
		header {
			defer
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		}
		import chainya_origin
	}

	@private path /payment/* /account /account/ /admin/* /manage /manage/
	handle @private {
		header {
			defer
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		}
		import chainya_origin
	}

	@api path /api/*
	handle @api {
		import chainya_public_headers
		header >Cache-Control "no-store"
		import chainya_origin
	}

	@catalogMedia path /catalog-media/*
	handle @catalogMedia {
		import chainya_public_headers
		import chainya_origin
	}

	redir /index.html / 308
	redir /shop/ /shop 308
	redir /business/ /business 308
	redir /booking/ /booking 308

	@publicApp path / /shop /business /booking
	handle @publicApp {
		import chainya_public_headers
		header Cache-Control "no-cache"
		try_files {path}/index.html /index.html
		file_server
	}

	# Статические изображения и шрифты редко меняются, но их URL пока не
	# версионированы. Часовой cache с обязательной перепроверкой ускоряет
	# повторные открытия и не оставляет старые файлы у клиента надолго.
	@staticAssets path /img/* /fonts/* /favicon* /og.*
	handle @staticAssets {
		import chainya_public_headers
		header Cache-Control "public, max-age=3600, must-revalidate"
		file_server
	}

	handle {
		import chainya_public_headers
		file_server
	}

	handle_errors {
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
		}
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
		handle {
			rewrite * /50x.html
			file_server
		}
	}
}
