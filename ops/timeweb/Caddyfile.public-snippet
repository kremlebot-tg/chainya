# Добавляется к существующему внешнему Caddyfile Re-dnd Scout.
www.chainya.ru {
  redir https://chainya.ru{uri} permanent
}

chainya.ru {
  reverse_proxy 127.0.0.1:8078 {
    # The private edge intentionally binds to the loopback host only. Preserve
    # that site label here; it restores its API and sensitive-path matchers.
    header_up Host 127.0.0.1
  }
}
