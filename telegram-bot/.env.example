# Скопируйте этот файл в .env и впишите свои значения.
# Токен берётся у @BotFather (см. README.md). Никому не показывайте его.
BOT_TOKEN=replace_with_botfather_token

# Общий секрет с checkout backend. Создайте один раз командой
# `openssl rand -hex 32` и укажите то же значение в окружении chainya-shop.
BOOKING_BOT_SECRET=
BOOKING_API_URL=https://chainya.ru

# Бот валидирует и обновляет опубликованный каталог сайта каждые 5 минут.
CATALOG_API_URL=https://chainya.ru/api/catalog
CATALOG_REFRESH_SECONDS=300

# Необязательно: кому отправлять служебные уведомления бота. Основные брони
# сохраняет backend и он же уведомляет владельцев.
# OWNER_CHAT_ID=replace_with_numeric_chat_id
